# WemX Docker configuration
# Copy this file to docker/wemx.env and adjust the values:
#   cp docker/wemx.env.example docker/wemx.env
#
# These variables are passed to the WemX and database containers. They take precedence
# over the .env file that the web installer writes to the `wemx-config` volume.

# ── Application ──────────────────────────────────────────────
# Public URL of your installation. Used in emails and payment gateway callbacks.
APP_URL=http://localhost:8080
# Set to true when WemX is served over HTTPS (for example behind Caddy, Traefik or Nginx).
FORCE_HTTPS=false
APP_TIMEZONE=UTC
# Optional: provide your license key here instead of in the installer.
# LICENSE_KEY=WMX-...

# ── Database (used by WemX) ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wemx
DB_USERNAME=wemx
DB_PASSWORD=change-me-to-a-long-random-password

# ── Database server (used by the bundled MariaDB container) ──
# Keep these in sync with the DB_* values above.
MARIADB_DATABASE=wemx
MARIADB_USER=wemx
MARIADB_PASSWORD=change-me-to-a-long-random-password
MARIADB_ROOT_PASSWORD=change-me-to-another-long-random-password

# ── Container behaviour ──────────────────────────────────────
# Run database migrations on start-up once WemX is installed (recommended after updates).
WEMX_AUTO_MIGRATE=true
# Disable the built-in queue worker or scheduler if you run them in separate containers.
WEMX_RUN_QUEUE=true
WEMX_RUN_SCHEDULER=true

# ── Mail (optional, can also be configured in Admin → Emails) ─
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=billing@example.com
